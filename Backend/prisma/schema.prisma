// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CompanyDetails {
  companyId   Int    @id @default(autoincrement()) @map("company_id")
  companyName String @map("company_name")
  companyCode String @unique @map("company_code")

  companyLogo  String? @map("company_logo")
  companyEmail String  @unique @map("company_email")
  companyPhone String? @map("company_phone")
  website      String?

  gstNumber          String? @map("gst_number")
  panNumber          String? @map("pan_number")
  cinNumber          String? @map("cin_number")
  registrationNumber String? @map("registration_number")

  industryType String? @map("industry_type")
  companyType  String? @map("company_type")

  foundedDate DateTime? @map("founded_date")

  employeeStrength Int? @map("employee_strength")

  currency String?

  workingHoursPerDay Float? @map("working_hours_per_day")
  workingDaysPerWeek Int?   @map("working_days_per_week")

  officeStartTime String? @map("office_start_time")
  officeEndTime   String? @map("office_end_time")

  allowedRadius Int? @map("allowed_radius")

  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments         Department[]
  users               User[]
  roles               Role[]
  superAdmin          SuperAdmin?
  officeLocations     OfficeLocation[]
  designations        Designation[]
  calendars           Calendar[]
  holidays            Holiday[]
  attendances         Attendance[]
  attendanceRequests  AttendanceRequest[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  leavePolicies       LeavePolicy[]
  leaveAccumulations       LeaveAccumulation[]
  leaveYearEndProcesses    LeaveYearEndProcess[]
  compOffPolicies          CompOffPolicy[]
  compOffAssigns           CompOffAssign[]
  weekOffs                 WeekOff[]
  weekOffAssigns           WeekOffAssign[]
  assets              AssetDetails[]
  reimbursementClaims ReimbursementClaim[]

  @@map("company_details")
}

// ==========================
// Super Admin
// ==========================
model SuperAdmin {
  superAdminId Int @id @default(autoincrement()) @map("super_admin_id")

  companyId Int @unique @map("company_id")

  email    String @unique
  password String

  firstName   String  @map("first_name")
  lastName    String? @map("last_name")
  phoneNumber String? @map("phone_number")

  status Boolean @default(true)

  lastLogin DateTime? @map("last_login")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@map("super_admins")
}

model Role {
  roleId      Int     @id @default(autoincrement()) @map("role_id")
  companyId   Int     @map("company_id")
  roleName    String  @map("role_name")
  roleCode    String  @map("role_code")
  description String?
  status      Boolean @default(true)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  company CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, roleName])
  @@unique([companyId, roleCode])
  @@map("roles")
}

model Permission {
  permissionId   Int     @id @default(autoincrement()) @map("permission_id")
  permissionName String  @unique @map("permission_name")
  permissionCode String  @unique @map("permission_code")
  module         String
  description    String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  departmentId   Int      @id @default(autoincrement()) @map("department_id")
  companyId      Int      @map("company_id")
  departmentCode String   @map("department_code")
  departmentName String   @map("department_name")
  departmentHead Int?     @map("department_head")
  description    String?
  status         Boolean  @default(true)
  createdBy      Int?     @map("created_by") // FK -> Users.user_id
  updatedBy      Int?     @map("updated_by") // FK -> Users.user_id
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company       CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  createdByUser User?          @relation("DepartmentCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?          @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [userId])
  headUser      User?          @relation("DepartmentHead", fields: [departmentHead], references: [userId])
  users         User[]         @relation("DepartmentUsers")
  designations  Designation[]

  @@unique([companyId, departmentCode])
  @@map("departments")
}

// ==========================
// User
// ==========================
model User {
  userId       Int    @id @default(autoincrement()) @map("user_id")
  employeeCode String @unique @map("employee_code")

  companyId     Int  @map("company_id")
  departmentId  Int? @map("department_id")
  locationId    Int? @map("location_id")
  designationId Int? @map("designation_id")

  firstName String @map("first_name")
  lastName  String @map("last_name")

  officialEmail String  @unique @map("official_email")
  phoneNumber   String? @map("phone_number")
  password      String

  employmentType EmploymentType @map("employment_type")

  joiningDate      DateTime  @map("joining_date")
  probationEndDate DateTime? @map("probation_end_date")

  reportingToId Int? @map("reporting_to")
  shiftId       Int? @map("shift_id")

  status EmployeeStatus @default(ACTIVE)

  lastLogin DateTime? @map("last_login")

  createdBy Int? @map("created_by")
  updatedBy Int? @map("updated_by")

  profilePic String? @map("profile_pic") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     CompanyDetails  @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  department  Department?     @relation("DepartmentUsers", fields: [departmentId], references: [departmentId])
  location    OfficeLocation? @relation("LocationUsers", fields: [locationId], references: [officeLocationId])
  designation Designation?    @relation("DesignationUsers", fields: [designationId], references: [designationId])

  manager      User?  @relation("ReportingManager", fields: [reportingToId], references: [userId])
  subordinates User[] @relation("ReportingManager")

  createdByUser User?  @relation("UserCreatedBy", fields: [createdBy], references: [userId])
  createdUsers  User[] @relation("UserCreatedBy")

  updatedByUser User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [userId])
  updatedUsers  User[] @relation("UserUpdatedBy")

  createdDepartments  Department[]     @relation("DepartmentCreatedBy")
  updatedDepartments  Department[]     @relation("DepartmentUpdatedBy")
  headedDepartments   Department[]     @relation("DepartmentHead")
  createdLocations    OfficeLocation[] @relation("LocationCreatedBy")
  createdDesignations Designation[]    @relation("DesignationCreatedBy")
  createdCalendars    Calendar[]       @relation("CalendarCreatedBy")
  createdHolidays     Holiday[]        @relation("HolidayCreatedBy")

  personalInformation PersonalInformation?
  parentsInformation  ParentsInformation?
  addresses           AddressInformation[]
  bankDetails         BankDetails[]
  documents           EmployeeDocument[]
  pfDetail            PFDetail?
  esiDetail           ESIDetail?
  insuranceDetail     InsuranceDetail?
  attendances         Attendance[]
  attendanceRequests  AttendanceRequest[]  @relation("AttendanceRequestUser")
  approvedAttendanceReqs AttendanceRequest[] @relation("AttendanceRequestApprovedBy")
  createdLeaveTypes   LeaveType[]          @relation("LeaveTypeCreatedBy")
  leaveRequests       LeaveRequest[]       @relation("LeaveRequestUser")
  approvedLeaves      LeaveRequest[]       @relation("LeaveRequestApprovedBy")
  leaveAccumulations  LeaveAccumulation[]
  leaveYearEndProcesses LeaveYearEndProcess[] @relation("YearEndProcessUser")
  processedYearEnds     LeaveYearEndProcess[] @relation("YearEndProcessedBy")
  createdCompOffPolicies CompOffPolicy[]      @relation("CompOffPolicyCreatedBy")
  updatedCompOffPolicies CompOffPolicy[]      @relation("CompOffPolicyUpdatedBy")
  compOffAssigns         CompOffAssign[]
  createdCompOffAssigns  CompOffAssign[]      @relation("CompOffAssignCreatedBy")
  updatedCompOffAssigns  CompOffAssign[]      @relation("CompOffAssignUpdatedBy")

  createdWeekOffs        WeekOff[]            @relation("WeekOffCreatedBy")
  updatedWeekOffs        WeekOff[]            @relation("WeekOffUpdatedBy")
  weekOffAssigns         WeekOffAssign[]
  createdWeekOffAssigns  WeekOffAssign[]      @relation("WeekOffAssignCreatedBy")
  updatedWeekOffAssigns  WeekOffAssign[]      @relation("WeekOffAssignUpdatedBy")

  assetAssignments AssetAssignments[]
  assetHistory     AssetHistory[]

  reimbursementClaims    ReimbursementClaim[]
  approvedReimbursements ReimbursementClaim[]   @relation("ReimbursementApprovedBy")
  reimbursementHistories ReimbursementHistory[]

  userRoles UserRole[]

  @@map("users")
}

// ==========================
// Personal Information
// ==========================
model PersonalInformation {
  personalInfoId Int @id @default(autoincrement()) @map("personal_info_id")
  userId         Int @unique @map("user_id")

  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  maritalStatus String?   @map("marital_status")
  bloodGroup    String?   @map("blood_group")
  nationality   String?
  religion      String?
  motherTongue  String?   @map("mother_tongue")

  aadhaarNumber        String? @unique @map("aadhaar_number")
  panNumber            String? @unique @map("pan_number")
  passportNumber       String? @unique @map("passport_number")
  drivingLicenseNumber String? @unique @map("driving_license_number")

  officialEmail String? @map("official_email")
  personalEmail String? @map("personal_email")
  profilePhoto  String? @map("profile_photo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("personal_information")
}

// ==========================
// Parents Information
// ==========================
model ParentsInformation {
  parentId Int @id @default(autoincrement()) @map("parent_id")
  userId   Int @unique @map("user_id")

  fatherName       String? @map("father_name")
  fatherMobile     String? @map("father_mobile")
  fatherOccupation String? @map("father_occupation")

  motherName       String? @map("mother_name")
  motherMobile     String? @map("mother_mobile")
  motherOccupation String? @map("mother_occupation")

  guardianName   String? @map("guardian_name")
  guardianMobile String? @map("guardian_mobile")
  relationship   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("parents_information")
}

// ==========================
// Address Information
// ==========================
model AddressInformation {
  addressId Int @id @default(autoincrement()) @map("address_id")
  userId    Int @map("user_id")

  addressType AddressType @map("address_type")

  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")

  city       String
  state      String
  country    String
  postalCode String @map("postal_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, addressType])
  @@map("address_information")
}

// ==========================
// Bank Details
// ==========================
model BankDetails {
  bankId Int @id @default(autoincrement()) @map("bank_id")
  userId Int @map("user_id")

  accountHolderName String @map("account_holder_name")
  bankName          String @map("bank_name")
  branchName        String @map("branch_name")
  accountNumber     String @map("account_number")
  ifscCode          String @map("ifsc_code")
  accountType       String @map("account_type")

  upiId         String? @map("upi_id")
  salaryAccount Boolean @default(false) @map("salary_account")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("bank_details")
}

// ==========================
// Employee Documents
// ==========================
model EmployeeDocument {
  documentId Int @id @default(autoincrement()) @map("document_id")

  userId Int @map("user_id")

  documentType DocumentType @map("document_type")

  document String @map("document") @db.Text

  fileName String? @map("file_name")
  mimeType String? @map("mime_type")

  status Boolean @default(true)

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("employee_documents")
}

// ==========================
// Enums
// ==========================
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum AddressType {
  CURRENT
  PERMANENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ==========================
// PF Details
// ==========================
model PFDetail {
  pfDetailId Int @id @default(autoincrement()) @map("pf_detail_id")

  userId Int @unique @map("user_id")

  uanNumber String? @map("uan_number")

  isInternationalWorker Boolean @default(false) @map("is_international_worker")

  educationLevel String? @map("education_level")

  pfNumber String? @map("pf_number")

  pfJoiningDate DateTime? @map("pf_joining_date")

  pfLeavingDate DateTime? @map("pf_leaving_date")

  documentNumber String? @map("document_number")

  documentType String? @map("document_type")

  documentExpiryDate DateTime? @map("document_expiry_date")

  reasonForLeaving String? @map("reason_for_leaving")

  phcCategory String? @map("phc_category")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("pf_details")
}

// ==========================
// ESI Details
// ==========================
model ESIDetail {
  esiDetailId Int @id @default(autoincrement()) @map("esi_detail_id")

  userId Int @unique @map("user_id")

  esiNumber String? @map("esi_number")

  esiJoiningDate DateTime? @map("esi_joining_date")

  esiLeavingDate DateTime? @map("esi_leaving_date")

  reasonForLeaving String? @map("reason_for_leaving")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("esi_details")
}

// ==========================
// Insurance Details
// ==========================
model InsuranceDetail {
  insuranceId Int @id @default(autoincrement()) @map("insurance_id")

  userId Int @unique @map("user_id")

  insuranceProvider String? @map("insurance_provider")

  insuranceType String? @map("insurance_type")

  policyNumber String? @map("policy_number")

  insuranceExpiryDate DateTime? @map("insurance_expiry_date")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("insurance_details")
}

enum EducationLevel {
  BELOW_10TH
  SSLC
  PUC
  DIPLOMA
  GRADUATE
  POST_GRADUATE
  DOCTORATE
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PHOTO
  RESUME
  OFFER_LETTER
  EXPERIENCE_CERTIFICATE
  DEGREE_CERTIFICATE
  SALARY_SLIP
  RELIEVING_LETTER
  OTHER
}

enum ReasonForLeaving {
  RESIGNED
  TERMINATED
  RETIRED
  TRANSFERRED
  CONTRACT_COMPLETED
  DECEASED
  OTHER
}

enum PHCCategory {
  GENERAL
  PH
  EXEMPT
}

enum InsuranceType {
  HEALTH
  LIFE
  ACCIDENT
  GROUP_MEDICAL
  GROUP_LIFE
  OTHER
}

// ==========================
// Office Location
// ==========================
model OfficeLocation {
  officeLocationId Int @id @default(autoincrement()) @map("office_location_id")

  companyId Int @map("company_id")

  locationCode String @map("location_code")

  locationName String @map("location_name")

  addressLine1 String? @map("address_line1")

  addressLine2 String? @map("address_line2")

  city String?

  state String?

  country String?

  pincode String?

  officePhoneNumber String? @map("office_phone_number")

  mobileNumber String? @map("mobile_number")

  fax String?

  website String?

  timezone String?

  latitude Decimal? @db.Decimal(10, 8)

  longitude Decimal? @db.Decimal(11, 8)

  remarks String?

  status Boolean @default(true)

  createdBy Int? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  company CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  createdUser User?  @relation("LocationCreatedBy", fields: [createdBy], references: [userId])
  users       User[] @relation("LocationUsers")

  @@unique([companyId, locationCode])
  @@map("office_locations")
}

// ==========================
// Designation
// ==========================
model Designation {
  designationId   Int      @id @default(autoincrement()) @map("designation_id")
  companyId       Int      @map("company_id")
  departmentId    Int      @map("department_id")
  designationCode String   @map("designation_code")
  designationName String   @map("designation_name")
  remarks         String?
  status          Boolean  @default(true)
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  department  Department     @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)
  createdUser User?          @relation("DesignationCreatedBy", fields: [createdBy], references: [userId])
  users       User[]         @relation("DesignationUsers")

  @@unique([companyId, designationCode])
  @@map("designations")
}

// ==========================
// Calendar
// ==========================
model Calendar {
  calendarId   Int      @id @default(autoincrement()) @map("calendar_id")
  companyId    Int      @map("company_id")
  calendarCode String   @map("calendar_code")
  calendarName String   @map("calendar_name")
  remarks      String?
  status       Boolean  @default(true)
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  createdUser User?          @relation("CalendarCreatedBy", fields: [createdBy], references: [userId])
  holidays    Holiday[]

  @@unique([companyId, calendarCode])
  @@map("calendars")
}

// ==========================
// Holiday
// ==========================
model Holiday {
  holidayId   Int         @id @default(autoincrement()) @map("holiday_id")
  calendarId  Int         @map("calendar_id")
  companyId   Int         @map("company_id")
  holidayCode String      @map("holiday_code")
  holidayName String      @map("holiday_name")
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  holidayType HolidayType @map("holiday_type")
  isHalfDay   Boolean     @default(false) @map("is_half_day")
  isOptional  Boolean     @default(false) @map("is_optional")
  remarks     String?
  status      Boolean     @default(true)
  createdBy   Int?        @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  calendar    Calendar       @relation(fields: [calendarId], references: [calendarId], onDelete: Cascade)
  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  createdUser User?          @relation("HolidayCreatedBy", fields: [createdBy], references: [userId])

  @@unique([companyId, calendarId, holidayCode])
  @@map("holidays")
}

enum HolidayType {
  HOLIDAY
  WEEK_OFF
}

// ==========================
// Attendance
// ==========================
model Attendance {
  attendanceId Int @id @default(autoincrement()) @map("attendance_id")
  companyId    Int @map("company_id")
  userId       Int @map("user_id")

  attendanceDate DateTime  @map("attendance_date") @db.Date
  checkInTime    DateTime? @map("check_in_time") @db.Time
  checkOutTime   DateTime? @map("check_out_time") @db.Time

  checkInLatitude      Decimal? @map("check_in_latitude") @db.Decimal(10, 8)
  checkInLongitude     Decimal? @map("check_in_longitude") @db.Decimal(11, 8)
  checkOutLatitude     Decimal? @map("check_out_latitude") @db.Decimal(10, 8)
  checkOutLongitude    Decimal? @map("check_out_longitude") @db.Decimal(11, 8)
  workingMinutes       Int?     @map("working_minutes")
  overtimeMinutes      Int?     @map("overtime_minutes")
  earlyCheckoutMinutes Int?     @map("early_checkout_minutes")

  attendanceStatus AttendanceStatus @map("attendance_status")
  remarks          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("attendances")
}

// ==========================
// Attendance Request
// ==========================
model AttendanceRequest {
  requestId    Int @id @default(autoincrement()) @map("request_id")
  companyId    Int @map("company_id")
  userId       Int @map("user_id")

  shiftDate    DateTime  @map("shift_date") @db.Date
  reason       AttendanceRequestReason @map("reason")
  checkInTime  DateTime? @map("check_in_time") @db.Time
  checkOutTime DateTime? @map("check_out_time") @db.Time
  isNextDay    Boolean   @default(false) @map("is_next_day")
  remarks      String    @map("remarks")
  
  status       AttendanceRequestStatus @default(PENDING)
  
  approvedBy      Int?      @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user         User           @relation("AttendanceRequestUser", fields: [userId], references: [userId], onDelete: Cascade)
  approvedUser User?          @relation("AttendanceRequestApprovedBy", fields: [approvedBy], references: [userId])

  @@map("attendance_requests")
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceRequestReason {
  BUSINESS_TOUR
  FORGOT_ID
  NEW_JOINEE
  ON_DUTY
  OTHERS
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  WEEK_OFF
  HOLIDAY
}

// ==========================
// Leave Type
// ==========================
model LeaveType {
  leaveTypeId Int      @id @default(autoincrement()) @map("leave_type_id")
  companyId   Int      @map("company_id")
  leaveCode   String   @map("leave_code")
  leaveName   String   @map("leave_name")
  remarks     String?
  status      Boolean  @default(true)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  createdUser   User?          @relation("LeaveTypeCreatedBy", fields: [createdBy], references: [userId])
  leaveRequests LeaveRequest[]
  leavePolicyRules LeavePolicyRule[]
  leavePolicyAccumulations LeavePolicyAccumulation[]
  leaveAccumulations       LeaveAccumulation[]
  leaveYearEndProcesses    LeaveYearEndProcess[]
  compOffPolicies          CompOffPolicy[]

  @@unique([companyId, leaveCode])
  @@map("leave_types")
}

// ==========================
// Leave Request
// ==========================
model LeaveRequest {
  leaveRequestId Int @id @default(autoincrement()) @map("leave_request_id")
  companyId      Int @map("company_id")
  userId         Int @map("user_id")
  leaveTypeId    Int @map("leave_type_id")

  fromDate     DateTime @map("from_date")
  toDate       DateTime @map("to_date")
  numberOfDays Float    @map("number_of_days")
  reason       String

  status LeaveStatus @default(PENDING)

  approvedBy      Int?      @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  remarks         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user         User           @relation("LeaveRequestUser", fields: [userId], references: [userId], onDelete: Cascade)
  leaveType    LeaveType      @relation(fields: [leaveTypeId], references: [leaveTypeId])
  approvedUser User?          @relation("LeaveRequestApprovedBy", fields: [approvedBy], references: [userId])

  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==========================
// Asset Management
// ==========================
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  DAMAGED
  RETIRED
}

model AssetDetails {
  assetId   Int @id @default(autoincrement()) @map("asset_id")
  companyId Int @map("company_id")

  assetCode String @map("asset_code")
  assetName String @map("asset_name")
  assetType String @map("asset_type")

  brand        String? @map("brand")
  model        String? @map("model")
  serialNumber String? @unique @map("serial_number")

  purchaseDate  DateTime? @map("purchase_date")
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  vendorName    String?   @map("vendor_name")

  warrantyStartDate DateTime? @map("warranty_start_date")
  warrantyEndDate   DateTime? @map("warranty_end_date")

  assetStatus AssetStatus @default(AVAILABLE) @map("asset_status")

  description String?

  createdBy Int? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     CompanyDetails     @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  assignments AssetAssignments[]
  history     AssetHistory[]

  @@unique([companyId, assetCode])
  @@map("asset_details")
}

model AssetAssignments {
  assignmentId Int @id @default(autoincrement()) @map("assignment_id")

  assetId Int @map("asset_id")
  userId  Int @map("user_id")

  assignedDate       DateTime  @map("assigned_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  returnedDate       DateTime? @map("returned_date")

  assignmentStatus      String? @map("assignment_status")
  conditionAtAssignment String? @map("condition_at_assignment")
  conditionAtReturn     String? @map("condition_at_return")

  assignedBy Int?    @map("assigned_by")
  returnedBy Int?    @map("returned_by")
  remarks    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset AssetDetails @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("asset_assignments")
}

model AssetHistory {
  historyId Int @id @default(autoincrement()) @map("history_id")

  assetId Int  @map("asset_id")
  userId  Int? @map("user_id")

  action         String
  previousStatus String? @map("previous_status")
  newStatus      String? @map("new_status")

  actionDate  DateTime @map("action_date")
  remarks     String?
  performedBy Int?     @map("performed_by")

  createdAt DateTime @default(now()) @map("created_at")

  asset AssetDetails @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [userId])

  @@map("asset_history")
}

// ==========================
// Reimbursements
// ==========================

enum ReimbursementStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model ReimbursementClaim {
  claimId           Int                 @id @default(autoincrement()) @map("claim_id")
  companyId         Int                 @map("company_id")
  userId            Int                 @map("user_id")
  claimNumber       String              @map("claim_number")
  reimbursementType String              @map("reimbursement_type")
  claimDate         DateTime            @map("claim_date")
  totalAmount       Decimal             @map("total_amount") @db.Decimal(12, 2)
  approvedAmount    Decimal?            @map("approved_amount") @db.Decimal(12, 2)
  description       String?
  status            ReimbursementStatus @default(DRAFT)
  submittedAt       DateTime?           @map("submitted_at")
  approvedBy        Int?                @map("approved_by")
  approvedAt        DateTime?           @map("approved_at")
  rejectionReason   String?             @map("rejection_reason")
  paymentDate       DateTime?           @map("payment_date")
  remarks           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [userId])
  approver User?          @relation("ReimbursementApprovedBy", fields: [approvedBy], references: [userId])

  bills   ReimbursementBill[]
  history ReimbursementHistory[]

  @@unique([companyId, claimNumber])
  @@map("reimbursement_claims")
}

model ReimbursementBill {
  billId     Int       @id @default(autoincrement()) @map("bill_id")
  claimId    Int       @map("claim_id")
  billNumber String?   @map("bill_number")
  billDate   DateTime? @map("bill_date")
  billAmount Decimal   @map("bill_amount") @db.Decimal(12, 2)
  vendorName String?   @map("vendor_name")
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  fileSize   Int       @map("file_size")
  fileData   Bytes     @map("file_data") @db.ByteA
  createdAt  DateTime  @default(now()) @map("created_at")

  claim ReimbursementClaim @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  @@map("reimbursement_bills")
}

model ReimbursementHistory {
  historyId      Int      @id @default(autoincrement()) @map("history_id")
  claimId        Int      @map("claim_id")
  action         String
  previousStatus String?  @map("previous_status")
  newStatus      String?  @map("new_status")
  actionBy       Int?     @map("action_by")
  actionDate     DateTime @default(now()) @map("action_date")
  remarks        String?

  claim ReimbursementClaim @relation(fields: [claimId], references: [claimId], onDelete: Cascade)
  user  User?              @relation(fields: [actionBy], references: [userId])

  @@map("reimbursement_history")
}

// ==========================
// Leave Policies
// ==========================
model LeavePolicy {
  leavePolicyId Int      @id @default(autoincrement()) @map("leave_policy_id")
  companyId     Int      @map("company_id")
  policyName    String   @map("policy_name") @db.VarChar(100)
  policyCode    String   @map("policy_code") @db.VarChar(50)
  remarks       String?  @db.Text
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  company                 CompanyDetails            @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  leavePolicyRules        LeavePolicyRule[]
  leavePolicyAccumulations LeavePolicyAccumulation[]
  leaveAccumulations       LeaveAccumulation[]
  leaveYearEndProcesses    LeaveYearEndProcess[]

  @@unique([companyId, policyCode], name: "uq_leave_policy_code")
  @@map("leave_policies")
}

model LeavePolicyRule {
  leavePolicyRuleId           Int      @id @default(autoincrement()) @map("leave_policy_rule_id")
  leavePolicyId               Int      @map("leave_policy_id")
  leaveTypeId                 Int      @map("leave_type_id")
  
  requestSubmissionDays       Int?     @map("request_submission_days")
  requestSubmissionPeriod     String?  @map("request_submission_period") @db.VarChar(20)
  
  informLeaveGreaterThan      Decimal? @db.Decimal(5, 2) @map("inform_leave_greater_than")
  informAfterDays             Int?     @map("inform_after_days")
  informPeriod                String?  @map("inform_period") @db.VarChar(20)
  
  minLeaveDays                Decimal? @db.Decimal(5, 2) @map("min_leave_days")
  maxLeaveDays                Decimal? @db.Decimal(5, 2) @map("max_leave_days")
  annualRequestLimit          Decimal? @db.Decimal(8, 2) @map("annual_request_limit")
  
  isPaid                      Boolean  @default(false) @map("is_paid")
  payMultiplier               Decimal? @default(1.00) @db.Decimal(5, 2) @map("pay_multiplier")
  
  allowFileAttachment         Boolean  @default(false) @map("allow_file_attachment")
  attachmentRequiredAfterDays Int?     @default(0) @map("attachment_required_after_days")
  
  countHolidayDuring          Boolean  @default(false) @map("count_holiday_during")
  countHolidayAfter           Boolean  @default(false) @map("count_holiday_after")
  countHolidayBefore          Boolean  @default(false) @map("count_holiday_before")
  optionalHolidayOnly         Boolean  @default(false) @map("optional_holiday_only")
  
  countWeekoffDuring          Boolean  @default(false) @map("count_weekoff_during")
  countWeekoffAfter           Boolean  @default(false) @map("count_weekoff_after")
  countWeekoffBefore          Boolean  @default(false) @map("count_weekoff_before")
  
  status                      Boolean  @default(true)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at")

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [leavePolicyId], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [leaveTypeId], onDelete: Cascade)

  @@map("leave_policies_rules")
}

model LeavePolicyAccumulation {
  leavePolicyAccumulationId Int      @id @default(autoincrement()) @map("leave_policy_accumulation_id")
  leavePolicyId             Int      @map("leave_policy_id")
  leaveTypeId               Int      @map("leave_type_id")
  
  autoAccumulate            Boolean  @default(false) @map("auto_accumulate")
  considerDateOfJoining     Boolean  @default(false) @map("consider_date_of_joining")
  considerDateOfProbation   Boolean  @default(false) @map("consider_date_of_probation")
  
  accumulationStartDays     Int?     @default(0) @map("accumulation_start_days")
  accumulationAmount        Decimal? @db.Decimal(8, 2) @map("accumulation_amount")
  accumulationFrequency     String?  @map("accumulation_frequency") @db.VarChar(20)
  
  accumulationDay           Int?     @map("accumulation_day")
  accumulationMonth         Int?     @map("accumulation_month")
  
  expiryPeriod              String?  @map("expiry_period") @db.VarChar(30)
  
  basedOnDaysPresent        Boolean  @default(false) @map("based_on_days_present")
  presencePeriod            String?  @map("presence_period") @db.VarChar(20)
  
  considerForEncashment     Boolean  @default(false) @map("consider_for_encashment")
  
  maxLeaveBalance           Decimal? @db.Decimal(8, 2) @map("max_leave_balance")
  maxAccumulationPerYear    Decimal? @db.Decimal(8, 2) @map("max_accumulation_per_year")
  maxNegativeBalance        Decimal? @db.Decimal(8, 2) @map("max_negative_balance")
  maxCarryForward           Decimal? @db.Decimal(8, 2) @map("max_carry_forward")
  
  remainingLeaveAction      String?  @map("remaining_leave_action") @db.VarChar(20)
  
  status                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [leavePolicyId], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [leaveTypeId], onDelete: Cascade)

  @@map("leave_policy_accumulations")
}

// ==========================
// Leave Accumulation
// ==========================
model LeaveAccumulation {
  leaveAccumulationId Int @id @default(autoincrement()) @map("leave_accumulation_id")
  companyId           Int @map("company_id")
  userId              Int @map("user_id")
  leaveTypeId         Int @map("leave_type_id")
  leavePolicyId       Int? @map("leave_policy_id")

  accumulationDate       DateTime @map("accumulation_date") @db.Date
  numberOfLeaves         Decimal  @map("number_of_leaves") @db.Decimal(8, 2)
  
  isOpeningBalance       Boolean  @default(false) @map("is_opening_balance")
  
  accumulationPeriodFrom DateTime @map("accumulation_period_from") @db.Date
  accumulationPeriodTo   DateTime @map("accumulation_period_to") @db.Date
  
  availabilityPeriodFrom DateTime @map("availability_period_from") @db.Date
  availabilityPeriodTo   DateTime @map("availability_period_to") @db.Date
  
  note                   String?  @db.Text
  status                 Boolean  @default(true)
  
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  leaveType   LeaveType      @relation(fields: [leaveTypeId], references: [leaveTypeId], onDelete: Cascade)
  leavePolicy LeavePolicy?   @relation(fields: [leavePolicyId], references: [leavePolicyId], onDelete: Cascade)

  @@map("leave_accumulations")
}

// ==========================
// Leave Year End Process
// ==========================
model LeaveYearEndProcess {
  processId          Int @id @default(autoincrement()) @map("process_id")
  companyId          Int @map("company_id")
  userId             Int @map("user_id")
  leaveTypeId        Int @map("leave_type_id")
  leavePolicyId      Int? @map("leave_policy_id")

  year               Int
  closingBalance     Decimal  @map("closing_balance") @db.Decimal(8, 2)
  carryForwardLeaves Decimal  @map("carry_forward_leaves") @db.Decimal(8, 2)
  encashedLeaves     Decimal  @map("encashed_leaves") @db.Decimal(8, 2)
  lapsedLeaves       Decimal  @map("lapsed_leaves") @db.Decimal(8, 2)
  encashmentAmount   Decimal? @map("encashment_amount") @db.Decimal(12, 2)

  processedBy        Int?     @map("processed_by")
  processDate        DateTime @default(now()) @map("process_date")
  
  remarks            String?  @db.Text
  status             Boolean  @default(true)
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  company       CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user          User           @relation("YearEndProcessUser", fields: [userId], references: [userId], onDelete: Cascade)
  leaveType     LeaveType      @relation(fields: [leaveTypeId], references: [leaveTypeId], onDelete: Cascade)
  leavePolicy   LeavePolicy?   @relation(fields: [leavePolicyId], references: [leavePolicyId], onDelete: Cascade)
  processedUser User?          @relation("YearEndProcessedBy", fields: [processedBy], references: [userId])

  @@map("leave_year_end_processes")
}

// ==========================
// Comp Off Policy
// ==========================
model CompOffPolicy {
  id                   Int @id @default(autoincrement()) @map("id")
  companyId            Int @map("company_id")
  policyName           String @map("policy_name") @db.VarChar(150)
  leaveTypeId          Int @map("leave_type_id")

  // Based on day mark
  weekOffWorked        Boolean @default(false) @map("week_off_worked")
  holidayWorked        Boolean @default(false) @map("holiday_worked")

  // Based on hours
  otHoursEnabled       Boolean @default(false) @map("ot_hours_enabled")
  otFullDayHours       Int? @default(0) @map("ot_full_day_hours")
  otFullDayMinutes     Int? @default(0) @map("ot_full_day_minutes")
  otHalfDayHours       Int? @default(0) @map("ot_half_day_hours")
  otHalfDayMinutes     Int? @default(0) @map("ot_half_day_minutes")

  regularHoursEnabled  Boolean @default(false) @map("regular_hours_enabled")
  regularFullDayHours  Int? @default(0) @map("regular_full_day_hours")
  regularFullDayMinutes Int? @default(0) @map("regular_full_day_minutes")
  regularHalfDayHours  Int? @default(0) @map("regular_half_day_hours")
  regularHalfDayMinutes Int? @default(0) @map("regular_half_day_minutes")

  // Availability period
  availabilityType     String @map("availability_type") @db.VarChar(30)
  availabilityDays     Int? @map("availability_days")

  // Accumulation
  accumulationType     String @map("accumulation_type") @db.VarChar(30)

  // Employee request
  requestRequired      Boolean @default(false) @map("request_required")

  // Request deadline
  requestDeadlineType  String? @map("request_deadline_type") @db.VarChar(30)
  requestWithinDays    Int? @map("request_within_days")

  // Request limits
  maxRequestsPerMonth  Int? @map("max_requests_per_month")
  maxRequestsPerYear   Int? @map("max_requests_per_year")

  status               Boolean @default(true)

  createdBy            Int? @map("created_by")
  updatedBy            Int? @map("updated_by")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  leaveType   LeaveType      @relation(fields: [leaveTypeId], references: [leaveTypeId], onDelete: Cascade)
  createdUser User?          @relation("CompOffPolicyCreatedBy", fields: [createdBy], references: [userId])
  updatedUser User?          @relation("CompOffPolicyUpdatedBy", fields: [updatedBy], references: [userId])

  compOffAssigns CompOffAssign[]

  @@map("comp_off_policies")
}

// ==========================
// Comp Off Assign
// ==========================
model CompOffAssign {
  id        Int      @id @default(autoincrement()) @map("id")
  companyId Int      @map("company_id")
  userId    Int      @map("user_id")
  policyId  Int      @map("policy_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  status    Boolean  @default(true)

  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  policy      CompOffPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdUser User?          @relation("CompOffAssignCreatedBy", fields: [createdBy], references: [userId])
  updatedUser User?          @relation("CompOffAssignUpdatedBy", fields: [updatedBy], references: [userId])

  @@map("comp_off_assigns")
}

// ==========================
// Week Off Configuration
// ==========================
model WeekOff {
  weekOffId   Int      @id @default(autoincrement()) @map("week_off_id")
  companyId   Int      @map("company_id")
  code        String   @map("code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(150)
  status      Boolean  @default(true)
  
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  createdUser User?          @relation("WeekOffCreatedBy", fields: [createdBy], references: [userId])
  updatedUser User?          @relation("WeekOffUpdatedBy", fields: [updatedBy], references: [userId])

  rules       WeekOffRule[]
  assigns     WeekOffAssign[]

  @@unique([companyId, code])
  @@map("week_offs")
}

model WeekOffRule {
  ruleId      Int      @id @default(autoincrement()) @map("rule_id")
  weekOffId   Int      @map("week_off_id")
  frequency   String   @map("frequency") @db.VarChar(50) // Every, First, Second, Third, Fourth, Fifth
  dayOfWeek   String   @map("day_of_week") @db.VarChar(50) // Sunday, Monday, ...
  duration    String   @map("duration") @db.VarChar(50) // All day, First half, Second half

  weekOff     WeekOff  @relation(fields: [weekOffId], references: [weekOffId], onDelete: Cascade)

  @@map("week_off_rules")
}

model WeekOffAssign {
  assignId    Int      @id @default(autoincrement()) @map("assign_id")
  companyId   Int      @map("company_id")
  userId      Int      @map("user_id")
  weekOffId   Int      @map("week_off_id")
  
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      Boolean  @default(true)

  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company     CompanyDetails @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  weekOff     WeekOff        @relation(fields: [weekOffId], references: [weekOffId], onDelete: Cascade)
  createdUser User?          @relation("WeekOffAssignCreatedBy", fields: [createdBy], references: [userId])
  updatedUser User?          @relation("WeekOffAssignUpdatedBy", fields: [updatedBy], references: [userId])

  @@map("week_off_assigns")
}
